ARG golang_image
ARG base_image

# The Red Hat Go toolchain supplies system-crypto support. The exact image
# must be pinned by the release pipeline to the approved RHEL content set.
FROM ${golang_image} AS builder
WORKDIR /tmp
RUN mkdir -p /tmp/workspace && chmod 0777 /tmp/workspace
WORKDIR /tmp/workspace
ARG TARGETARCH
ENV GO111MODULE=on \
    GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GO_BUILD_TAGS=strictfipsruntime,no_openssl \
    GOFLAGS=-buildvcs=false
COPY . ./
RUN make build-aws-vpc-cni && make build-linux

FROM ${base_image}
RUN microdnf install -y ca-certificates iproute iptables openssl-libs util-linux-core \
    && microdnf clean all
ENV GODEBUG=fips140=auto
WORKDIR /app
COPY --from=builder /tmp/workspace/aws-cni \
    /tmp/workspace/misc/10-aws.conflist \
    /tmp/workspace/misc/eni-max-pods.txt \
    /tmp/workspace/aws-k8s-agent \
    /tmp/workspace/grpc-health-probe \
    /tmp/workspace/egress-cni \
    /tmp/workspace/aws-vpc-cni /app/
ENTRYPOINT ["/app/aws-vpc-cni"]
