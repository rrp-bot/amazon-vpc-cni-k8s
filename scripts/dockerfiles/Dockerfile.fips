ARG golang_image
ARG base_image

# The Red Hat Go toolchain supplies system-crypto support. The exact image
# must be pinned by the release pipeline to the approved RHEL content set.
FROM ${golang_image} AS builder
WORKDIR /tmp/amazon-vpc-cni-k8s
ARG TARGETARCH
ENV GO111MODULE=on \
    GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GO_BUILD_TAGS=strictfipsruntime,no_openssl
COPY . ./
RUN make build-aws-vpc-cni && make build-linux

FROM ${base_image}
RUN microdnf install -y ca-certificates iproute iptables openssl-libs util-linux-core \
    && microdnf clean all
ENV GODEBUG=fips140=auto
WORKDIR /app
COPY --from=builder /tmp/amazon-vpc-cni-k8s/aws-cni \
    /tmp/amazon-vpc-cni-k8s/misc/10-aws.conflist \
    /tmp/amazon-vpc-cni-k8s/misc/eni-max-pods.txt \
    /tmp/amazon-vpc-cni-k8s/aws-k8s-agent \
    /tmp/amazon-vpc-cni-k8s/grpc-health-probe \
    /tmp/amazon-vpc-cni-k8s/egress-cni \
    /tmp/amazon-vpc-cni-k8s/aws-vpc-cni /app/
ENTRYPOINT ["/app/aws-vpc-cni"]
